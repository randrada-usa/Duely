# Public client configuration only. Each checkout/worktree needs its own ignored
# .env.local with these two values from the Duely Supabase project's Connect dialog.
# Never place a Supabase secret or service-role key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google OAuth is handled by Supabase Auth. Configure its Google provider and
# allow duely://auth/callback in Supabase; no Android client ID is read here.

# Public UX gate only. The Edge Function separately enforces its server-only
# GEMINI_REAL_DATA_ENABLED secret and never exposes GEMINI_API_KEY to the app.
EXPO_PUBLIC_GEMINI_ASSIST_ENABLED=false

# Internal Android builds only. Never enable Test Store in production.
EXPO_PUBLIC_REVENUECAT_SANDBOX_ENABLED=false
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=
