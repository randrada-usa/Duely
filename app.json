{
  "expo": {
    "name": "Duely",
    "slug": "duely",
    "version": "1.0.0",
    "scheme": "duely",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.duely.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F43EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#5B6FE8",
          "defaultChannel": "task-reminders"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Duely to use your camera to capture one assignment image.",
          "photosPermission": "Allow Duely to access the one assignment image you choose.",
          "microphonePermission": false,
          "colors": {
            "cropToolbarColor": "#1A1A2E",
            "cropToolbarIconColor": "#FFFFFF",
            "cropToolbarActionTextColor": "#FFFFFF",
            "cropBackButtonIconColor": "#FFFFFF",
            "cropBackgroundColor": "#10101F"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F8FF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-mlkit-ocr",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "45655a6e-8201-4380-9d27-668bb04207bd"
      }
    },
    "owner": "rayands"
  }
}
